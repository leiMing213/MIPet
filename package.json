{
  "name": "mipet-desktop-pet",
  "version": "0.1.0",
  "description": "MiPet - MBTI driven AI desktop pet",
  "main": "out/main/index.js",
  "author": "MiPet Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "server:dev": "server\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8787 --app-dir server",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.mipet.desktop",
    "productName": "MiPet",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "resources/mipet-icon.png" },
    "extraResources": [
      { "from": "resources/mipet-icon.png", "to": "mipet-icon.png" }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "electron-winstaller"]
  }
}
